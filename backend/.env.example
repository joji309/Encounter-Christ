# Django Secret Key
SECRET_KEY=replace-with-a-long-random-secret

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,encounterchrist.online,www.encounterchrist.online,.vercel.app

# Database URL (required for production; local development may leave this blank)
# Example Neon DB: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/encounter_christ?sslmode=require
DATABASE_URL=

# Cloudinary Storage (For high-resolution media & audio uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public frontend URL (used by the Django development proxy)
NEXT_FRONTEND_URL=http://127.0.0.1:3000

# Production CORS/CSRF configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Vercel production reference (configure these values in the Vercel dashboard,
# not in a committed .env file):
# DEBUG=False
# ALLOWED_HOSTS=encounterchrist.online,www.encounterchrist.online,.vercel.app
# CORS_ALLOWED_ORIGINS=https://encounterchrist.online,https://www.encounterchrist.online,https://encounter-christ.vercel.app
# CSRF_TRUSTED_ORIGINS=https://encounterchrist.online,https://www.encounterchrist.online,https://encounter-christ.vercel.app
# NEXT_PUBLIC_SITE_URL=https://encounterchrist.online
